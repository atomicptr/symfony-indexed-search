parameters:
  level: 10
  tmpDir: var/cache/phpstan
  paths:
    - src/
    - config/
  ignoreErrors:
    -
      identifier: shipmonk.deadMethod
      message: '#^Unused .+::__construct$#'
      path: src/*
  shipmonkDeadCode:
    usageExcluders:
      tests:
        enabled: true
  parallel:
    maximumNumberOfProcesses: 16
    jobSize: 50
    processTimeout: 60.0
